# ====================================
# Book RAG - 环境变量配置
# ====================================

# ------------------------------------
# LLM 配置（OpenRouter）
# ------------------------------------
# 获取 API Key: https://openrouter.ai/
# 支持模型: deepseek, gpt-4, claude-opus, gemini, llama 等
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认 LLM 模型（可选）
# 选项: deepseek, deepseek-reasoner, gpt-4, gpt-3.5, claude-opus, claude-sonnet, gemini, llama
DEFAULT_LLM_MODEL=deepseek

# ------------------------------------
# Embedding 配置
# ------------------------------------
# 使用 sentence-transformers 进行文本向量化
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# ------------------------------------
# Chroma 向量数据库配置
# ------------------------------------
CHROMA_COLLECTION_NAME=knowledge_base

# ------------------------------------
# 检索配置
# ------------------------------------
# 最大检索数量
TOP_K_RETRIEVALS=10

# ------------------------------------
# Reranker 配置（使用 FlashRank）
# ------------------------------------
# 启用 Rerank 重排序
RERANKER_ENABLED=false
# Reranker 后保留的文档数量
RERANKER_TOP_K=5
# Reranker 模型（空值使用默认模型 ms-marco-TinyBERT-L-2-v2）
# 可选: "", "ms-marco-TinyBERT-L-2-v2", "ms-marco-MiniLM-L-12-v2"
RERANKER_MODEL=

# ------------------------------------
# API 服务配置
# ------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
