# ====================================
# Book RAG - 环境变量配置
# ====================================

# ------------------------------------
# LLM 配置（OpenRouter）
# ------------------------------------
# 获取 API Key: https://openrouter.ai/
# 支持模型: deepseek, gpt-4, claude-opus, gemini, llama 等
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认 LLM 模型（可选）
# 选项: deepseek, deepseek-reasoner, gpt-4, gpt-3.5, claude-opus, claude-sonnet, gemini, llama
DEFAULT_LLM_MODEL=deepseek

# LLM 生成参数（可选）
# temperature: 控制输出随机性（0.0-1.0，默认 0.7）
# - 越低输出越确定性，越高越创造性
LLM_TEMPERATURE=0.7

# top_p: 核采样参数（0.0-1.0，默认 1.0）
# - 与 temperature 二选一使用，通常不需要同时调整
LLM_TOP_P=1.0

# ------------------------------------
# Embedding 配置
# ------------------------------------
# 可选模型（修改后请先在 UI 中删除所有文件，再重新上传）：
# - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (默认，轻量级多语言)
# - shibing624/text2vec-base-chinese (中文专用)
# - moka-ai/m3e-base (中文语义理解优秀)
# - BAAI/bge-m3 (高质量多语言)
# - sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (更高质量)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# ------------------------------------
# Chroma 向量数据库配置
# ------------------------------------
CHROMA_COLLECTION_NAME=knowledge_base

# ------------------------------------
# 检索配置
# ------------------------------------
# 最大检索数量
TOP_K_RETRIEVALS=10

# ------------------------------------
# Reranker 配置（使用 FlashRank）
# ------------------------------------
# 启用 Rerank 重排序
RERANKER_ENABLED=false
# Reranker 后保留的文档数量
RERANKER_TOP_K=5
# Reranker 模型（空值使用默认模型 ms-marco-TinyBERT-L-2-v2）
# 可选: "", "ms-marco-TinyBERT-L-2-v2", "ms-marco-MiniLM-L-12-v2"
RERANKER_MODEL=

